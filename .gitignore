node_modules/
*.log
.DS_Store

# eval workspaces: generated plugin projects, not sources
skills/*-workspace/
.plugin-preview/

# claude plugin eval writes its runs here
evals/results/

# eval fixture installs: the fixture installs the kit from npm; a run against a pre-release build
# installs it from a packed tarball instead, and the lockfile would then carry the operator's own path
skills/apps-ui-kit/evals/fixtures/consumer-app/package-lock.json
