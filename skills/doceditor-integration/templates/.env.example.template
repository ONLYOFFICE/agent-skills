# Copy to .env and fill in real values. Never commit .env; never hardcode
# any of these as a fallback in application source — infrastructure/compose.md's
# ENVIRONMENT section: fail startup instead if one is unset.

JWT_SECRET=change-me-in-real-deployment

# Internal address: this backend's own server-side calls to Document Server.
DOCUMENT_SERVER_URL=http://documentserver

# Public address: what the BROWSER uses to reach Document Server (script
# tag, iframe, WebSocket). Must differ from the internal address whenever
# they are not the same origin — see compose.md's address-split section
# and callback/handler.md's WithPublicOrigin rewrite.
DOCUMENT_SERVER_PUBLIC_URL=http://localhost:{{DOCUMENTSERVER_PUBLISHED_PORT}}

PORT={{BACKEND_PORT}}
STORAGE_DIR=/data
